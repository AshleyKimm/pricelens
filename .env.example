# Copy to .env in the PROJECT ROOT (gitignored) and fill in. Never commit .env.

# Gemini (default provider). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free = Google may train on / human-review inputs -> only public/fake images allowed (enforced).
# Set to "paid" only if the key's Cloud project has active billing.
GEMINI_TIER=free

# Claude (optional second provider). Key from https://platform.claude.com
# ANTHROPIC_API_KEY=

# Optional
# PRICELENS_PROVIDER=gemini
# PRICELENS_MODEL=gemini-3.6-flash
# PRICELENS_DB=data/pricelens.db
# PRICELENS_LOCALE=US
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
